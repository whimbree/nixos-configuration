#!/usr/bin/env bash
# Thin out years of znapzend snapshots, in two reviewable steps.
#
#   prune-old-snapshots plan [--all] [--list FILE]   # read-only; writes a plan
#   sudo prune-old-snapshots destroy PLANFILE        # destroys exactly that plan
#
# Only snapshots named like znapzend's (@YYYY-MM-DD-HHMMSS) are ever touched, so
# hand-named snapshots, rpool/local/root@blank and sanoid's autosnap_* are safe.
# Per dataset this keeps:
#   - everything from the last 7 days (incremental replication needs a common
#     snapshot on both sides)
#   - the last one of each day for 90 days
#   - the last one of each month for 24 months
#   - the last one of each year, forever
#   - the newest snapshot, however old it is
# Datasets with 100 or fewer such snapshots are skipped unless --all is given.
#
# plan writes PLANFILE (to destroy) and PLANFILE.keep (every snapshot that would
# remain, including the ones this script never touches).
#
# It works from names only: reading snapshot properties is very slow when there
# are hundreds of thousands of them.
set -euo pipefail
export LC_ALL=C

usage() { sed -n '2,5p' "$0" >&2; exit 2; }

is_znapzend='^[^@]+@20[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{6}$'
# First line of a plan. Change it with the rule, so stale plans are refused.
header='# prune-old-snapshots rule: 7d-all 90d-daily 24m-monthly yearly'

plan() {
  local min=100 list=""
  while (($#)); do
    case "$1" in
      --all) min=0 ;;
      --list) list="${2:?--list needs a file}"; shift ;;
      *) usage ;;
    esac
    shift
  done

  local recent first_day first_month out
  recent=$(date -d '7 days ago' +%Y-%m-%d-%H%M%S)
  first_day=$(date -d '90 days ago' +%Y-%m-%d)
  first_month=$(date -d "$(date +%Y-%m-01) -24 months" +%Y-%m)
  out=$(mktemp "${TMPDIR:-/tmp}/snapshot-plan.XXXXXX")
  work=$(mktemp -d)
  trap 'rm -rf -- "$work"' EXIT

  if [[ -n $list ]]; then
    sort -u -- "$list" > "$work/all"
  else
    zfs list -H -t snapshot -o name -s name | sort -u > "$work/all"
  fi

  { grep -E "$is_znapzend" "$work/all" || true; } |
    awk -F@ -v recent="$recent" -v first_day="$first_day" \
      -v first_month="$first_month" -v min="$min" -v out="$work/destroy" '
      # Sorted, so a snapshot is the last of its day, month or year when the
      # next one belongs to a different day, month or year.
      function flush(   i, day, month, year, next_s, keep_it, kept) {
        if (n == 0) return
        if (n <= min) { skipped++; n = 0; return }
        kept = 0
        for (i = 1; i <= n; i++) {
          next_s = (i < n) ? s[i + 1] : ""
          day = substr(s[i], 1, 10); month = substr(s[i], 1, 7); year = substr(s[i], 1, 4)
          keep_it = (i == n) || (s[i] >= recent) \
            || (day >= first_day && day != substr(next_s, 1, 10)) \
            || (month >= first_month && month != substr(next_s, 1, 7)) \
            || (year != substr(next_s, 1, 4))
          if (keep_it) kept++
          else print ds "@" s[i] > out
        }
        printf "%-62s %7d -> %d\n", ds, n, kept
        total += n; keep += kept; n = 0
      }
      $1 != ds { flush(); ds = $1 }
      { s[++n] = $2 }
      END {
        flush()
        printf "\n%d of %d snapshots in these datasets would be destroyed, %d kept; %d smaller datasets left alone\n", total - keep, total, keep, skipped
      }'

  touch "$work/destroy"
  sort -o "$work/destroy" "$work/destroy"
  comm -23 "$work/all" "$work/destroy" > "$out.keep"
  { echo "$header"; cat "$work/destroy"; } > "$out"
  printf '%d snapshots would remain on this host\n\n' "$(wc -l < "$out.keep")"
  echo "To destroy: $out"
  echo "To remain:  $out.keep"
}

destroy() {
  local file="${1:?usage: destroy PLANFILE}" count ds chunk=()
  if [[ $(head -n 1 -- "$file") != "$header" ]]; then
    echo "refusing: $file was not made by this version's rule; run plan again" >&2
    return 1
  fi
  count=$(($(wc -l < "$file") - 1))
  ((count > 0)) || { echo "plan is empty"; return 0; }
  if tail -n +2 -- "$file" | grep -qvE "$is_znapzend"; then
    echo "refusing: plan contains names this script would never destroy" >&2
    return 1
  fi
  read -rp "Destroy $count snapshots on $(hostname)? Type the hostname to confirm: " answer
  [[ $answer == "$(hostname)" ]] || { echo "aborted"; return 1; }

  local failed=0 done_count=0 previous="" name
  run_chunk() {
    ((${#chunk[@]})) || return 0
    local joined; joined=$(IFS=,; echo "${chunk[*]}")
    if zfs destroy "$previous@$joined"; then
      done_count=$((done_count + ${#chunk[@]}))
    else
      failed=1
      echo "some snapshots of $previous could not be destroyed" >&2
    fi
    chunk=()
    printf '\r%d / %d' "$done_count" "$count"
  }
  while IFS= read -r name; do
    ds=${name%@*}
    if [[ $ds != "$previous" ]] || ((${#chunk[@]} >= 500)); then
      run_chunk
      previous=$ds
    fi
    chunk+=("${name#*@}")
  done < <(tail -n +2 -- "$file")
  run_chunk
  echo
  return $failed
}

case "${1:-}" in
  plan) shift; plan "$@" ;;
  destroy) shift; destroy "$@" ;;
  *) usage ;;
esac
